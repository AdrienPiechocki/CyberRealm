+void WaylandThread::window_state_setup_keyboard_shortcuts_inhibitor(WindowState &p_ws) {
+	// No-op silencieux si le compositeur n'expose pas le protocole ou si aucun
+	// seat n'est encore disponible : l'appelant (création de fenêtre, arrivée
+	// du manager global ou d'un wl_seat) retentera plus tard.
+	if (p_ws.wp_keyboard_shortcuts_inhibitor || !registry.wp_keyboard_shortcuts_inhibit_manager || registry.wl_seats.is_empty()) {
+		return;
+	}
+	ERR_FAIL_COND(p_ws.wl_surface == nullptr);
+
+	struct wl_seat *wl_seat = registry.wl_seats.front()->get();
+	p_ws.wp_keyboard_shortcuts_inhibitor = zwp_keyboard_shortcuts_inhibit_manager_v1_inhibit_shortcuts(registry.wp_keyboard_shortcuts_inhibit_manager, p_ws.wl_surface, wl_seat);
+
+	// Le compositeur active/désactive l'inhibiteur automatiquement quand la
+	// surface gagne ou perd le focus clavier (événements active/inactive
+	// purement informatifs) : rien d'autre à faire côté client.
+}
+
+void WaylandThread::window_setup_keyboard_shortcuts_inhibitors() {
+	// (Ré)essaie la création d'un inhibiteur pour toutes les fenêtres existantes
+	// (appelé quand le manager global arrive ou qu'un wl_seat est ajouté).
+	for (KeyValue<DisplayServerEnums::WindowID, WindowState> &E : windows) {
+		window_state_setup_keyboard_shortcuts_inhibitor(E.value);
+	}
+}
