+int KMSInput::_open_restricted(const char *p_path, int p_flags, void *p_user) {
+	KMSSeat *seat = static_cast<KMSInput *>(p_user)->seat;
+	int fd = -1;
+	if (seat->open_device(String::utf8(p_path), fd) < 0) {
+		return -EACCES;
+	}
+	return fd;
+}
+
+void KMSInput::_close_restricted(int p_fd, void *p_user) {
+	static_cast<KMSInput *>(p_user)->seat->close_device_by_fd(p_fd);
+}
+
+Error KMSInput::initialize(KMSSeat *p_seat, const Vector2i &p_bounds) {
+	seat = p_seat;
+	bounds = p_bounds;
+	pointer_pos = Vector2(p_bounds) / 2.0;
+
+#ifdef SOWRAP_ENABLED
+	ERR_FAIL_COND_V_MSG(initialize_xkbcommon(0) != 0, ERR_CANT_CREATE, "KMS: libxkbcommon introuvable.");
+#endif
+	KeyMappingXKB::initialize();
+	vt_switch_enabled = OS::get_singleton()->get_environment("CYBERREALM_KMS_VT_SWITCH") == "1";
+
+	xkb_ctx = xkb_context_new(XKB_CONTEXT_NO_FLAGS);
+	ERR_FAIL_NULL_V(xkb_ctx, ERR_CANT_CREATE);
+	// Disposition : variables XKB_DEFAULT_* si présentes, sinon la configuration
+	// système (/etc/vconsole.conf : XKBLAYOUT, XKBVARIANT, XKBMODEL, XKBOPTIONS,
+	// écrite par localectl), sinon "us". Sans cela une session lancée par le
+	// gestionnaire de connexion (aucune variable d'environnement) tape en QWERTY.
+	HashMap<String, String> vconsole;
+	if (Ref<FileAccess> f = FileAccess::open("/etc/vconsole.conf", FileAccess::READ); f.is_valid()) {
+		while (!f->eof_reached()) {
+			String line = f->get_line().strip_edges();
+			int eq = line.find_char('=');
+			if (line.begins_with("#") || eq <= 0) {
+				continue;
+			}
+			vconsole[line.substr(0, eq).strip_edges()] = line.substr(eq + 1).strip_edges().trim_prefix("\"").trim_suffix("\"");
+		}
+	}
+	auto pick = [&](const char *p_env, const char *p_vconsole) -> CharString {
+		if (!OS::get_singleton()->get_environment(p_env).is_empty()) {
+			return CharString(); // xkbcommon lit lui-même la variable d'environnement.
+		}
+		return vconsole.has(p_vconsole) ? vconsole[p_vconsole].utf8() : CharString();
+	};
+	CharString c_model = pick("XKB_DEFAULT_MODEL", "XKBMODEL");
+	CharString c_layout = pick("XKB_DEFAULT_LAYOUT", "XKBLAYOUT");
+	CharString c_variant = pick("XKB_DEFAULT_VARIANT", "XKBVARIANT");
+	CharString c_options = pick("XKB_DEFAULT_OPTIONS", "XKBOPTIONS");
+	xkb_rule_names names = {};
+	names.model = c_model.is_empty() ? nullptr : c_model.get_data();
+	names.layout = c_layout.is_empty() ? nullptr : c_layout.get_data();
+	names.variant = c_variant.is_empty() ? nullptr : c_variant.get_data();
+	names.options = c_options.is_empty() ? nullptr : c_options.get_data();
+	print_line(vformat("KMS: clavier layout=%s variant=%s",
+			names.layout ? String::utf8(names.layout) : OS::get_singleton()->get_environment("XKB_DEFAULT_LAYOUT"),
+			names.variant ? String::utf8(names.variant) : OS::get_singleton()->get_environment("XKB_DEFAULT_VARIANT")));
+	xkb_map = xkb_keymap_new_from_names(xkb_ctx, &names, XKB_KEYMAP_COMPILE_NO_FLAGS);
+	ERR_FAIL_NULL_V_MSG(xkb_map, ERR_CANT_CREATE, "KMS: keymap XKB invalide.");
+	xkb_st = xkb_state_new(xkb_map);
+	ERR_FAIL_NULL_V(xkb_st, ERR_CANT_CREATE);
+
+	// Composition (touches mortes) : table de la locale, comme le backend Wayland.
+	// Un échec n'est pas fatal : on retombe sur la saisie sans composition.
+	{
+		OS *os = OS::get_singleton();
+		String locale = os->get_environment("LC_ALL");
+		if (locale.is_empty()) {
+			locale = os->get_environment("LC_CTYPE");
+		}
+		if (locale.is_empty()) {
+			locale = os->get_environment("LANG");
+		}
+		if (locale.is_empty()) {
+			locale = "C";
+		}
+		xkb_compose_tbl = xkb_compose_table_new_from_locale(xkb_ctx, locale.utf8().get_data(), XKB_COMPOSE_COMPILE_NO_FLAGS);
+		if (xkb_compose_tbl) {
+			xkb_compose_st = xkb_compose_state_new(xkb_compose_tbl, XKB_COMPOSE_STATE_NO_FLAGS);
+		} else {
+			WARN_PRINT("KMS: table Compose introuvable pour la locale « " + locale + " » — touches mortes indisponibles.");
+		}
+	}
+
+	static const libinput_interface iface = {
+		&KMSInput::_open_restricted,
+		&KMSInput::_close_restricted,
+	};
+	udev_ctx = udev_new();
+	ERR_FAIL_NULL_V(udev_ctx, ERR_CANT_CREATE);
+	li = libinput_udev_create_context(&iface, this, udev_ctx);
+	ERR_FAIL_NULL_V_MSG(li, ERR_CANT_CREATE, "KMS: libinput_udev_create_context a échoué.");
+	ERR_FAIL_COND_V_MSG(libinput_udev_assign_seat(li, seat->get_seat_name().utf8().get_data()) != 0, ERR_CANT_OPEN, "KMS: libinput_udev_assign_seat a échoué.");
+	return OK;
+}
+
+void KMSInput::finalize() {
+	if (li) {
+		libinput_unref(li);
+		li = nullptr;
+	}
+	if (udev_ctx) {
+		udev_unref(udev_ctx);
+		udev_ctx = nullptr;
+	}
+	if (xkb_compose_st) {
+		xkb_compose_state_unref(xkb_compose_st);
+		xkb_compose_st = nullptr;
+	}
+	if (xkb_compose_tbl) {
+		xkb_compose_table_unref(xkb_compose_tbl);
+		xkb_compose_tbl = nullptr;
+	}
+	if (xkb_st) {
+		xkb_state_unref(xkb_st);
+		xkb_st = nullptr;
+	}
+	if (xkb_map) {
+		xkb_keymap_unref(xkb_map);
+		xkb_map = nullptr;
+	}
+	if (xkb_ctx) {
+		xkb_context_unref(xkb_ctx);
+		xkb_ctx = nullptr;
+	}
+}
+
+int KMSInput::get_fd() const {
+	return li ? libinput_get_fd(li) : -1;
+}
+
+void KMSInput::suspend() {
+	if (li) {
+		libinput_suspend(li);
+	}
+	repeat_keycode = 0;
+	if (xkb_compose_st) {
+		xkb_compose_state_reset(xkb_compose_st);
+	}
+}
+
+void KMSInput::resume() {
+	if (li) {
+		libinput_resume(li);
+	}
+}
+
+void KMSInput::_update_modifiers() {
+	shift = xkb_state_mod_name_is_active(xkb_st, XKB_MOD_NAME_SHIFT, XKB_STATE_MODS_EFFECTIVE) > 0;
+	ctrl = xkb_state_mod_name_is_active(xkb_st, XKB_MOD_NAME_CTRL, XKB_STATE_MODS_EFFECTIVE) > 0;
+	alt = xkb_state_mod_name_is_active(xkb_st, XKB_MOD_NAME_ALT, XKB_STATE_MODS_EFFECTIVE) > 0;
+	meta = xkb_state_mod_name_is_active(xkb_st, XKB_MOD_NAME_LOGO, XKB_STATE_MODS_EFFECTIVE) > 0;
+}
+
+void KMSInput::_emit_key(uint32_t p_xkb_keycode, bool p_pressed, bool p_echo, uint32_t p_unicode_override, bool p_use_override) {
+	// Même logique que WaylandThread::_seat_state_get_key_event().
+	Key shifted_key = KeyMappingXKB::get_keycode(xkb_state_key_get_one_sym(xkb_st, p_xkb_keycode));
+
+	Key plain_key = Key::NONE;
+	const xkb_keysym_t *syms = nullptr;
+	int n = xkb_keymap_key_get_syms_by_level(xkb_map, p_xkb_keycode, xkb_state_key_get_layout(xkb_st, p_xkb_keycode), 0, &syms);
+	if (n > 0 && syms) {
+		plain_key = KeyMappingXKB::get_keycode(syms[0]);
+	}
+
+	Key physical_keycode = KeyMappingXKB::get_scancode(p_xkb_keycode);
+	KeyLocation location = KeyMappingXKB::get_location(p_xkb_keycode);
+	uint32_t unicode = p_use_override ? p_unicode_override : xkb_state_key_get_utf32(xkb_st, p_xkb_keycode);
+
+	Key keycode = Key::NONE;
+	if ((shifted_key & Key::SPECIAL) != Key::NONE || (plain_key & Key::SPECIAL) != Key::NONE) {
+		keycode = shifted_key;
+	}
+	if (keycode == Key::NONE) {
+		keycode = plain_key;
+	}
+	if (keycode == Key::NONE) {
+		keycode = physical_keycode;
+	}
+	if (keycode >= Key::A + 32 && keycode <= Key::Z + 32) {
+		keycode -= 'a' - 'A';
+	}
+	if (physical_keycode == Key::NONE && keycode == Key::NONE && unicode == 0) {
+		return;
+	}
+
+	Ref<InputEventKey> k;
+	k.instantiate();
+	k->set_window_id(DisplayServerEnums::MAIN_WINDOW_ID);
+	k->set_shift_pressed(shift);
+	k->set_ctrl_pressed(ctrl);
+	k->set_alt_pressed(alt);
+	k->set_meta_pressed(meta);
+	k->set_pressed(p_pressed);
+	k->set_echo(p_echo);
+	k->set_keycode(keycode);
+	k->set_physical_keycode(physical_keycode);
+	k->set_location(location);
+	k->set_key_label(unicode != 0 ? fix_key_label(unicode, keycode) : keycode);
+	if (p_pressed) {
+		k->set_unicode(fix_unicode(unicode));
+	}
+	if (k->get_keycode() == Key::BACKTAB) {
+		k->set_keycode(Key::TAB);
+		k->set_physical_keycode(Key::TAB);
+		k->set_shift_pressed(true);
+	}
+	Input::get_singleton()->parse_input_event(k);
+}
+
+void KMSInput::_handle_key(uint32_t p_evdev_key, bool p_pressed, bool p_echo) {
+	uint32_t xkb_keycode = p_evdev_key + 8;
+	xkb_state_update_key(xkb_st, xkb_keycode, p_pressed ? XKB_KEY_DOWN : XKB_KEY_UP);
+	_update_modifiers();
+
+	// Changement de VT (Ctrl+Alt+F1..F12) : désactivé par défaut, car le retour
+	// de VT gelait l'écran (voir kms-display-driver.md). Opt-in avec
+	// CYBERREALM_KMS_VT_SWITCH=1 ; le watchdog (kms_watchdog.h) est le filet.
+	// Ctrl+Alt+Fn n'est de toute façon jamais transmis au jeu.
+	if (ctrl && alt && p_pressed) {
+		int vt = 0;
+		if (p_evdev_key >= KEY_F1 && p_evdev_key <= KEY_F10) {
+			vt = int(p_evdev_key - KEY_F1) + 1;
+		} else if (p_evdev_key == KEY_F11 || p_evdev_key == KEY_F12) {
+			vt = int(p_evdev_key - KEY_F11) + 11;
+		}
+		if (vt) {
+			if (vt_switch_enabled) {
+				print_line(vformat("KMS: demande de bascule vers VT%d", vt));
+				seat->switch_session(vt);
+			}
+			return;
+		}
+	}
+	bool consumed = false; // touche morte / séquence Compose en cours ou résolue
+	if (p_pressed && xkb_compose_st) {
+		xkb_keysym_t sym = xkb_state_key_get_one_sym(xkb_st, xkb_keycode);
+		// Les modificateurs sont ignorés par Compose (FEED_IGNORED) : ils passent normalement.
+		if (xkb_compose_state_feed(xkb_compose_st, sym) == XKB_COMPOSE_FEED_ACCEPTED) {
+			switch (xkb_compose_state_get_status(xkb_compose_st)) {
+				case XKB_COMPOSE_COMPOSING:
+				case XKB_COMPOSE_CANCELLED:
+					consumed = true; // touche morte mémorisée / séquence invalide : rien à émettre
+					break;
+				case XKB_COMPOSE_COMPOSED: {
+					char buf[256] = {};
+					int size = xkb_compose_state_get_utf8(xkb_compose_st, buf, sizeof(buf));
+					String composed = String::utf8(buf, size);
+					xkb_compose_state_reset(xkb_compose_st);
+					for (int i = 0; i < composed.length(); i++) {
+						_emit_key(xkb_keycode, true, p_echo, composed[i], true);
+					}
+					consumed = true;
+					break;
+				}
+				default:
+					break;
+			}
+		}
+	}
+
+	if (!consumed) {
+		_emit_key(xkb_keycode, p_pressed, p_echo);
+	}
+
+	if (p_pressed && !p_echo && !consumed && xkb_keymap_key_repeats(xkb_map, xkb_keycode)) {
+		repeat_keycode = xkb_keycode;
+		repeat_next_usec = OS::get_singleton()->get_ticks_usec() + REPEAT_DELAY_USEC;
+	} else if (!p_pressed && repeat_keycode == xkb_keycode) {
+		repeat_keycode = 0;
+	}
+}
+
+void KMSInput::_handle_motion(const Vector2 &p_delta) {
+	Vector2 old = pointer_pos;
+	pointer_pos += p_delta;
+	if (pointer_mode == POINTER_VISIBLE) {
+		pointer_pos = pointer_pos.clamp(Vector2(), Vector2(bounds) - Vector2(1, 1));
+	}
+	Ref<InputEventMouseMotion> mm;
+	mm.instantiate();
+	mm->set_window_id(DisplayServerEnums::MAIN_WINDOW_ID);
+	mm->set_shift_pressed(shift);
+	mm->set_ctrl_pressed(ctrl);
+	mm->set_alt_pressed(alt);
+	mm->set_meta_pressed(meta);
+	mm->set_position(pointer_pos);
+	mm->set_global_position(pointer_pos);
+	mm->set_button_mask(button_mask);
+	// En mode capturé le delta brut doit passer même si la position est figée.
+	Vector2 rel = (pointer_mode == POINTER_CAPTURED) ? p_delta : pointer_pos - old;
+	mm->set_relative(rel);
+	mm->set_relative_screen_position(rel);
+	mm->set_velocity(Input::get_singleton()->get_last_mouse_velocity());
+	Input::get_singleton()->parse_input_event(mm);
+}
+
+void KMSInput::_handle_button(uint32_t p_evdev_button, bool p_pressed) {
+	MouseButton b = MouseButton::NONE;
+	switch (p_evdev_button) {
+		case BTN_LEFT:
+			b = MouseButton::LEFT;
+			break;
+		case BTN_RIGHT:
+			b = MouseButton::RIGHT;
+			break;
+		case BTN_MIDDLE:
+			b = MouseButton::MIDDLE;
+			break;
+		case BTN_SIDE:
+			b = MouseButton::MB_XBUTTON1;
+			break;
+		case BTN_EXTRA:
+			b = MouseButton::MB_XBUTTON2;
+			break;
+		default:
+			return;
+	}
+	if (p_pressed) {
+		button_mask.set_flag(mouse_button_to_mask(b));
+	} else {
+		button_mask.clear_flag(mouse_button_to_mask(b));
+	}
+	Ref<InputEventMouseButton> mb;
+	mb.instantiate();
+	mb->set_window_id(DisplayServerEnums::MAIN_WINDOW_ID);
+	mb->set_shift_pressed(shift);
+	mb->set_ctrl_pressed(ctrl);
+	mb->set_alt_pressed(alt);
+	mb->set_meta_pressed(meta);
+	mb->set_position(pointer_pos);
+	mb->set_global_position(pointer_pos);
+	mb->set_button_index(b);
+	mb->set_button_mask(button_mask);
+	mb->set_pressed(p_pressed);
+	Input::get_singleton()->parse_input_event(mb);
+}
+
+void KMSInput::_emit_wheel(MouseButton p_button, float p_factor) {
+	for (int pressed = 1; pressed >= 0; pressed--) {
+		Ref<InputEventMouseButton> mb;
+		mb.instantiate();
+		mb->set_window_id(DisplayServerEnums::MAIN_WINDOW_ID);
+		mb->set_shift_pressed(shift);
+		mb->set_ctrl_pressed(ctrl);
+		mb->set_alt_pressed(alt);
+		mb->set_meta_pressed(meta);
+		mb->set_position(pointer_pos);
+		mb->set_global_position(pointer_pos);
+		mb->set_button_index(p_button);
+		mb->set_factor(p_factor);
+		mb->set_pressed(pressed);
+		BitField<MouseButtonMask> mask = button_mask;
+		if (pressed) {
+			mask.set_flag(mouse_button_to_mask(p_button));
+		}
+		mb->set_button_mask(mask);
+		Input::get_singleton()->parse_input_event(mb);
+	}
+}
+
+void KMSInput::process() {
+	if (!li) {
+		return;
+	}
+	if (libinput_dispatch(li) < 0) {
+		return;
+	}
+	while (libinput_event *ev = libinput_get_event(li)) {
+		switch (libinput_event_get_type(ev)) {
+			case LIBINPUT_EVENT_KEYBOARD_KEY: {
+				libinput_event_keyboard *kb = libinput_event_get_keyboard_event(ev);
+				_handle_key(libinput_event_keyboard_get_key(kb), libinput_event_keyboard_get_key_state(kb) == LIBINPUT_KEY_STATE_PRESSED);
+			} break;
+			case LIBINPUT_EVENT_POINTER_MOTION: {
+				libinput_event_pointer *p = libinput_event_get_pointer_event(ev);
+				_handle_motion(Vector2(libinput_event_pointer_get_dx(p), libinput_event_pointer_get_dy(p)));
+			} break;
+			case LIBINPUT_EVENT_POINTER_BUTTON: {
+				libinput_event_pointer *p = libinput_event_get_pointer_event(ev);
+				_handle_button(libinput_event_pointer_get_button(p), libinput_event_pointer_get_button_state(p) == LIBINPUT_BUTTON_STATE_PRESSED);
+			} break;
+			case LIBINPUT_EVENT_POINTER_SCROLL_WHEEL: {
+				libinput_event_pointer *p = libinput_event_get_pointer_event(ev);
+				if (libinput_event_pointer_has_axis(p, LIBINPUT_POINTER_AXIS_SCROLL_VERTICAL)) {
+					double v = libinput_event_pointer_get_scroll_value_v120(p, LIBINPUT_POINTER_AXIS_SCROLL_VERTICAL);
+					if (v != 0) {
+						_emit_wheel(v < 0 ? MouseButton::WHEEL_UP : MouseButton::WHEEL_DOWN, Math::abs(v) / 120.0);
+					}
+				}
+				if (libinput_event_pointer_has_axis(p, LIBINPUT_POINTER_AXIS_SCROLL_HORIZONTAL)) {
+					double h = libinput_event_pointer_get_scroll_value_v120(p, LIBINPUT_POINTER_AXIS_SCROLL_HORIZONTAL);
+					if (h != 0) {
+						_emit_wheel(h < 0 ? MouseButton::WHEEL_LEFT : MouseButton::WHEEL_RIGHT, Math::abs(h) / 120.0);
+					}
+				}
+			} break;
+			case LIBINPUT_EVENT_POINTER_SCROLL_FINGER:
+			case LIBINPUT_EVENT_POINTER_SCROLL_CONTINUOUS: {
+				libinput_event_pointer *p = libinput_event_get_pointer_event(ev);
+				Vector2 d;
+				if (libinput_event_pointer_has_axis(p, LIBINPUT_POINTER_AXIS_SCROLL_HORIZONTAL)) {
+					d.x = libinput_event_pointer_get_scroll_value(p, LIBINPUT_POINTER_AXIS_SCROLL_HORIZONTAL);
+				}
+				if (libinput_event_pointer_has_axis(p, LIBINPUT_POINTER_AXIS_SCROLL_VERTICAL)) {
+					d.y = libinput_event_pointer_get_scroll_value(p, LIBINPUT_POINTER_AXIS_SCROLL_VERTICAL);
+				}
+				if (d != Vector2()) {
+					Ref<InputEventPanGesture> pg;
+					pg.instantiate();
+					pg->set_window_id(DisplayServerEnums::MAIN_WINDOW_ID);
+					pg->set_position(pointer_pos);
+					pg->set_delta(d / 10.0);
+					Input::get_singleton()->parse_input_event(pg);
+				}
+			} break;
+			default:
+				break;
+		}
+		libinput_event_destroy(ev);
+	}
+
+	if (repeat_keycode) {
+		uint64_t now = OS::get_singleton()->get_ticks_usec();
+		while (repeat_keycode && now >= repeat_next_usec) {
+			_emit_key(repeat_keycode, true, true);
+			repeat_next_usec += REPEAT_INTERVAL_USEC;
+		}
+	}
+}
+
+#endif // KMS_ENABLED
diff --git a/platform/linuxbsd/kms/kms_input.h b/platform/linuxbsd/kms/kms_input.h
new file mode 100644
index 0000000..a1458ee
--- /dev/null
+++ b/platform/linuxbsd/kms/kms_input.h
@@ -0,0 +1,82 @@
+#pragma once
+
+#ifdef KMS_ENABLED
+
+#include "core/input/input_enums.h"
+#include "core/math/vector2.h"
+#include "core/math/vector2i.h"
+#include "core/templates/bit_field.h"
+#include "core/os/keyboard.h"
+
+class KMSSeat;
+
+struct libinput;
+struct udev;
+struct xkb_context;
+struct xkb_keymap;
+struct xkb_state;
+struct xkb_compose_table;
+struct xkb_compose_state;
+
+// Clavier / souris via libinput (udev) + xkbcommon. Les périphériques sont
+// ouverts par libseat. Les événements sont injectés dans Input.
+class KMSInput {
+public:
+	enum PointerMode {
+		POINTER_VISIBLE,
+		POINTER_CAPTURED, // position non bornée, mouvements relatifs seulement
+	};
+
+private:
+	KMSSeat *seat = nullptr;
+	libinput *li = nullptr;
+	udev *udev_ctx = nullptr;
+	xkb_context *xkb_ctx = nullptr;
+	xkb_keymap *xkb_map = nullptr;
+	xkb_state *xkb_st = nullptr;
+	// Touches mortes (^, ¨, ´, `…) et séquences Compose.
+	xkb_compose_table *xkb_compose_tbl = nullptr;
+	xkb_compose_state *xkb_compose_st = nullptr;
+
+	Vector2i bounds;
+	Vector2 pointer_pos;
+	PointerMode pointer_mode = POINTER_VISIBLE;
+	BitField<MouseButtonMask> button_mask;
+	bool vt_switch_enabled = false;
+	bool shift = false, ctrl = false, alt = false, meta = false;
+
+	// Répétition de touches (libinput n'en fait pas).
+	uint32_t repeat_keycode = 0;
+	uint64_t repeat_next_usec = 0;
+	static constexpr uint64_t REPEAT_DELAY_USEC = 400000;
+	static constexpr uint64_t REPEAT_INTERVAL_USEC = 40000;
+
+	static int _open_restricted(const char *p_path, int p_flags, void *p_user);
+	static void _close_restricted(int p_fd, void *p_user);
+
+	void _update_modifiers();
+	void _handle_key(uint32_t p_evdev_key, bool p_pressed, bool p_echo = false);
+	void _emit_key(uint32_t p_xkb_keycode, bool p_pressed, bool p_echo, uint32_t p_unicode_override = 0, bool p_use_override = false);
+	void _handle_motion(const Vector2 &p_delta);
+	void _handle_button(uint32_t p_evdev_button, bool p_pressed);
+	void _emit_wheel(MouseButton p_button, float p_factor);
+
+public:
+	Error initialize(KMSSeat *p_seat, const Vector2i &p_bounds);
+	void finalize();
+
+	// Traite tout ce que libinput a en attente + les répétitions de touches.
+	void process();
+
+	// Suspension/reprise sur changement de VT.
+	void suspend();
+	void resume();
+
+	void set_pointer_mode(PointerMode p_mode) { pointer_mode = p_mode; }
+	Point2i get_pointer_position() const { return Point2i(pointer_pos); }
+	int get_fd() const;
+
+	~KMSInput() { finalize(); }
+};
+
+#endif // KMS_ENABLED
diff --git a/platform/linuxbsd/kms/kms_seat.cpp b/platform/linuxbsd/kms/kms_seat.cpp
new file mode 100644
index 0000000..00226ac
--- /dev/null
+++ b/platform/linuxbsd/kms/kms_seat.cpp
@@ -0,0 +1,126 @@
+#ifdef KMS_ENABLED
+
+#include "kms_seat.h"
+
+#include "core/os/os.h"
+
+// libseat.h n'a pas de garde extern "C".
+extern "C" {
+#include <libseat.h>
+}
+#include <cerrno>
+#include <cstring>
+
+void KMSSeat::_enable_cb(libseat *p_seat, void *p_user) {
+	KMSSeat *self = static_cast<KMSSeat *>(p_user);
+	self->active = true;
+	if (self->on_enable) {
+		self->on_enable(self->callback_user);
+	}
+}
+
+void KMSSeat::_disable_cb(libseat *p_seat, void *p_user) {
+	KMSSeat *self = static_cast<KMSSeat *>(p_user);
+	self->active = false;
+	// Les callbacks doivent cesser tout accès DRM/input ; l'acquittement
+	// (libseat_disable_seat) est fait ici, après eux.
+	if (self->on_disable) {
+		self->on_disable(self->callback_user);
+	}
+	self->acknowledge_disable();
+}
+
+Error KMSSeat::open() {
+	ERR_FAIL_COND_V(seat != nullptr, ERR_ALREADY_IN_USE);
+
+	static const libseat_seat_listener listener = {
+		&KMSSeat::_enable_cb,
+		&KMSSeat::_disable_cb,
+	};
+	seat = libseat_open_seat(&listener, this);
+	ERR_FAIL_NULL_V_MSG(seat, ERR_CANT_OPEN, vformat("KMS: libseat_open_seat a échoué (%s). Session logind/seatd requise.", strerror(errno)));
+
+	// Le callback enable_seat arrive pendant le premier dispatch.
+	for (int i = 0; i < 50 && !active; i++) {
+		if (libseat_dispatch(seat, 100) < 0) {
+			break;
+		}
+	}
+	if (!active) {
+		close();
+		ERR_FAIL_V_MSG(ERR_UNAVAILABLE, "KMS: la session n'est pas devenue active (pas sur un VT actif ?).");
+	}
+	return OK;
+}
+
+void KMSSeat::close() {
+	if (!seat) {
+		return;
+	}
+	for (const KeyValue<int, Device> &kv : devices) {
+		libseat_close_device(seat, kv.value.id);
+	}
+	devices.clear();
+	libseat_close_seat(seat);
+	seat = nullptr;
+	active = false;
+}
+
+int KMSSeat::get_fd() const {
+	return seat ? libseat_get_fd(seat) : -1;
+}
+
+Error KMSSeat::dispatch(int p_timeout_ms) {
+	ERR_FAIL_NULL_V(seat, ERR_UNCONFIGURED);
+	int r = libseat_dispatch(seat, p_timeout_ms);
+	return r < 0 ? FAILED : OK;
+}
+
+int KMSSeat::open_device(const String &p_path, int &r_fd) {
+	ERR_FAIL_NULL_V(seat, -1);
+	ERR_FAIL_COND_V_MSG(!active, -1, "KMS: open_device alors que la session est inactive.");
+	int fd = -1;
+	int id = libseat_open_device(seat, p_path.utf8().get_data(), &fd);
+	ERR_FAIL_COND_V_MSG(id < 0, -1, vformat("KMS: ouverture de %s refusée (%s).", p_path, strerror(errno)));
+	Device d;
+	d.id = id;
+	d.fd = fd;
+	d.path = p_path;
+	devices[id] = d;
+	r_fd = fd;
+	return id;
+}
+
+void KMSSeat::close_device(int p_device_id) {
+	if (!seat || !devices.has(p_device_id)) {
+		return;
+	}
+	libseat_close_device(seat, p_device_id);
+	devices.erase(p_device_id);
+}
+
+void KMSSeat::close_device_by_fd(int p_fd) {
+	for (const KeyValue<int, Device> &kv : devices) {
+		if (kv.value.fd == p_fd) {
+			close_device(kv.key);
+			return;
+		}
+	}
+}
+
+String KMSSeat::get_seat_name() const {
+	const char *name = seat ? libseat_seat_name(seat) : nullptr;
+	return name ? String::utf8(name) : String("seat0");
+}
+
+void KMSSeat::acknowledge_disable() {
+	if (seat) {
+		libseat_disable_seat(seat);
+	}
+}
+
+bool KMSSeat::switch_session(int p_vt) {
+	return seat && libseat_switch_session(seat, p_vt) == 0;
+}
+
+#endif // KMS_ENABLED
diff --git a/platform/linuxbsd/kms/kms_seat.h b/platform/linuxbsd/kms/kms_seat.h
new file mode 100644
index 0000000..9bc3fcf
--- /dev/null
+++ b/platform/linuxbsd/kms/kms_seat.h
@@ -0,0 +1,62 @@
+#pragma once
+
+#ifdef KMS_ENABLED
+
+#include "core/string/ustring.h"
+#include "core/templates/hash_map.h"
+#include "core/templates/local_vector.h"
+#include "core/templates/vector.h"
+
+struct libseat;
+
+// Session logind via libseat: ouvre les périphériques DRM / input sans root et
+// suit les changements de VT (disable_seat / enable_seat).
+class KMSSeat {
+public:
+	struct Device {
+		int id = -1;
+		int fd = -1;
+		String path;
+	};
+
+private:
+	libseat *seat = nullptr;
+	bool active = false;
+	HashMap<int, Device> devices; // device_id -> Device
+
+	static void _enable_cb(libseat *p_seat, void *p_user);
+	static void _disable_cb(libseat *p_seat, void *p_user);
+
+public:
+	// Appelés depuis dispatch() (thread principal). on_disable doit cesser tout
+	// accès DRM/input ; l'acquittement libseat est fait juste après.
+	void (*on_enable)(void *p_user) = nullptr;
+	void (*on_disable)(void *p_user) = nullptr;
+	void *callback_user = nullptr;
+
+	Error open();
+	void close();
+
+	bool is_open() const { return seat != nullptr; }
+	// false tant que la session n'a pas la main (VT inactif).
+	bool is_active() const { return active; }
+	// fd pollable pour le thread principal ; -1 si indisponible.
+	int get_fd() const;
+	// Traite les événements en attente (timeout en ms, 0 = non bloquant).
+	Error dispatch(int p_timeout_ms = 0);
+
+	// Renvoie l'id du device (>= 0) ou -1. Le fd est dans r_fd.
+	int open_device(const String &p_path, int &r_fd);
+	void close_device(int p_device_id);
+	void close_device_by_fd(int p_fd);
+	// Appelé par le DisplayServer quand on perd la session : ferme/ack.
+	void acknowledge_disable();
+
+	bool switch_session(int p_vt);
+	String get_seat_name() const;
+
+	KMSSeat() {}
+	~KMSSeat() { close(); }
+};
+
+#endif // KMS_ENABLED
diff --git a/platform/linuxbsd/kms/kms_watchdog.cpp b/platform/linuxbsd/kms/kms_watchdog.cpp
new file mode 100644
index 0000000..11a2ef9
--- /dev/null
+++ b/platform/linuxbsd/kms/kms_watchdog.cpp
@@ -0,0 +1,112 @@
+#ifdef KMS_ENABLED
+
+#include "kms_watchdog.h"
+
+#include <fcntl.h>
+#include <time.h>
+#include <unistd.h>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+static uint64_t _now_usec() {
+	timespec ts;
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	return uint64_t(ts.tv_sec) * 1000000ULL + uint64_t(ts.tv_nsec) / 1000ULL;
+}
+
+void KMSWatchdog::start() {
+	const char *m = getenv("CYBERREALM_KMS_WATCHDOG");
+	if (m && (!strcmp(m, "off") || !strcmp(m, "0"))) {
+		return;
+	}
+	mode = (m && !strcmp(m, "always")) ? MODE_ALWAYS : MODE_VT;
+	timeout_usec = (mode == MODE_ALWAYS) ? 10000000ULL : 5000000ULL;
+	if (const char *t = getenv("CYBERREALM_KMS_WATCHDOG_TIMEOUT")) {
+		double sec = atof(t);
+		if (sec >= 1.0) {
+			timeout_usec = uint64_t(sec * 1000000.0);
+		}
+	}
+	last_beat_usec = _now_usec();
+	armed_until_usec = (mode == MODE_ALWAYS) ? UINT64_MAX : 0;
+	stop_flag = false;
+	started = pthread_create(&thread, nullptr, _run, this) == 0;
+}
+
+void KMSWatchdog::stop() {
+	if (!started) {
+		return;
+	}
+	stop_flag = true;
+	pthread_join(thread, nullptr);
+	started = false;
+}
+
+void KMSWatchdog::heartbeat() {
+	last_beat_usec.store(_now_usec(), std::memory_order_relaxed);
+}
+
+void KMSWatchdog::on_session_enabled() {
+	if (!started || mode != MODE_VT) {
+		return;
+	}
+	uint64_t now = _now_usec();
+	last_beat_usec = now;
+	armed_until_usec = now + VT_WINDOW_USEC;
+}
+
+void KMSWatchdog::on_session_disabled() {
+	if (!started || mode != MODE_VT) {
+		return;
+	}
+	armed_until_usec = 0;
+}
+
+void *KMSWatchdog::_run(void *p_self) {
+	KMSWatchdog *self = static_cast<KMSWatchdog *>(p_self);
+	while (!self->stop_flag) {
+		usleep(250000);
+		uint64_t now = _now_usec();
+		uint64_t until = self->armed_until_usec;
+		if (until == 0 || (until != UINT64_MAX && now > until)) {
+			continue;
+		}
+		uint64_t last = self->last_beat_usec;
+		if (now > last && now - last > self->timeout_usec) {
+			self->_fire(now - last);
+		}
+	}
+	return nullptr;
+}
+
+void KMSWatchdog::_fire(uint64_t p_stale_usec) {
+	// Uniquement des appels async-signal-safe : le processus est dans un état
+	// douteux (thread principal bloqué dans le pilote graphique).
+	char msg[192];
+	int n = snprintf(msg, sizeof(msg),
+			"KMS watchdog: boucle principale bloquee depuis %.1f s -> arret du processus (libere l'ecran et le VT).\n",
+			double(p_stale_usec) / 1e6);
+	if (n > 0) {
+		(void)!write(STDERR_FILENO, msg, size_t(n));
+		const char *state = getenv("XDG_STATE_HOME");
+		const char *home = getenv("HOME");
+		char path[512] = {};
+		if (state && *state) {
+			snprintf(path, sizeof(path), "%s/cyberrealm-kms-watchdog.log", state);
+		} else if (home && *home) {
+			snprintf(path, sizeof(path), "%s/.cyberrealm-kms-watchdog.log", home);
+		}
+		if (path[0]) {
+			int fd = open(path, O_WRONLY | O_CREAT | O_APPEND | O_CLOEXEC, 0600);
+			if (fd >= 0) {
+				(void)!write(fd, msg, size_t(n));
+				fsync(fd);
+				close(fd);
+			}
+		}
+	}
+	_exit(70);
+}
+
+#endif // KMS_ENABLED
diff --git a/platform/linuxbsd/kms/kms_watchdog.h b/platform/linuxbsd/kms/kms_watchdog.h
new file mode 100644
index 0000000..845ca10
--- /dev/null
+++ b/platform/linuxbsd/kms/kms_watchdog.h
@@ -0,0 +1,54 @@
+#pragma once
+
+#ifdef KMS_ENABLED
+
+#include <atomic>
+#include <cstdint>
+#include <pthread.h>
+
+// Filet de sécurité contre les gels d'affichage (voir kms-display-driver.md :
+// le retour de VT a déjà figé tous les écrans). Le thread principal appelle
+// heartbeat() à chaque process_events(). Un thread dédié (le principal est
+// bloqué dans ce cas) surveille ce battement : s'il s'arrête trop longtemps
+// alors que le watchdog est armé, il journalise puis termine le processus.
+// Le noyau ferme alors les fds DRM, ce qui rend l'écran et le VT au système.
+//
+// CYBERREALM_KMS_WATCHDOG :
+//   "vt" (défaut)  armé seulement pendant VT_WINDOW_SEC après un retour de VT
+//                  (là où le gel est connu) : un long chargement ne tue donc pas le jeu ;
+//   "always"       armé en permanence, délai 10 s ;
+//   "off" / "0"    désactivé.
+// CYBERREALM_KMS_WATCHDOG_TIMEOUT : délai en secondes (défaut 5 en « vt »).
+class KMSWatchdog {
+public:
+	enum Mode { MODE_OFF, MODE_VT, MODE_ALWAYS };
+
+private:
+	Mode mode = MODE_OFF;
+	uint64_t timeout_usec = 5000000;
+	static constexpr uint64_t VT_WINDOW_USEC = 30000000;
+
+	std::atomic<uint64_t> last_beat_usec{ 0 };
+	std::atomic<uint64_t> armed_until_usec{ 0 }; // 0 = désarmé ; UINT64_MAX = toujours
+	std::atomic<bool> stop_flag{ false };
+	pthread_t thread;
+	bool started = false;
+
+	static void *_run(void *p_self);
+	void _fire(uint64_t p_stale_usec);
+
+public:
+	// Lit l'environnement et démarre le thread (sans effet si désactivé).
+	void start();
+	void stop();
+	// Thread principal, à chaque tour de boucle.
+	void heartbeat();
+	// Retour de VT : arme (mode « vt ») pour la fenêtre de surveillance.
+	void on_session_enabled();
+	// Perte de la session : le gel est normal, on désarme.
+	void on_session_disabled();
+
+	~KMSWatchdog() { stop(); }
+};
+
+#endif // KMS_ENABLED
diff --git a/platform/linuxbsd/kms/rendering_context_driver_vulkan_kms.cpp b/platform/linuxbsd/kms/rendering_context_driver_vulkan_kms.cpp
new file mode 100644
index 0000000..cd8bb22
--- /dev/null
+++ b/platform/linuxbsd/kms/rendering_context_driver_vulkan_kms.cpp
@@ -0,0 +1,185 @@
+#ifdef VULKAN_ENABLED
+#ifdef KMS_ENABLED
+
+#include "rendering_context_driver_vulkan_kms.h"
+
+#include <drivers/vulkan/godot_vulkan.h>
+
+#include "core/variant/variant.h"
+
+#include <xf86drm.h>
+#include <xf86drmMode.h>
+
+const char *RenderingContextDriverVulkanKMS::_get_platform_surface_extension() const {
+	return VK_KHR_DISPLAY_EXTENSION_NAME;
+}
+
+void RenderingContextDriverVulkanKMS::_register_platform_instance_extensions() {
+	_register_requested_instance_extension(VK_EXT_DIRECT_MODE_DISPLAY_EXTENSION_NAME, true);
+	_register_requested_instance_extension(VK_EXT_ACQUIRE_DRM_DISPLAY_EXTENSION_NAME, true);
+	// Requis par VK_EXT_direct_mode_display.
+	_register_requested_instance_extension(VK_KHR_GET_DISPLAY_PROPERTIES_2_EXTENSION_NAME, false);
+}
+
+static uint32_t _find_connected_connector(int p_fd) {
+	drmModeRes *res = drmModeGetResources(p_fd);
+	if (!res) {
+		return 0;
+	}
+	uint32_t found = 0;
+	for (int i = 0; i < res->count_connectors && !found; i++) {
+		drmModeConnector *c = drmModeGetConnector(p_fd, res->connectors[i]);
+		if (c && c->connection == DRM_MODE_CONNECTED && c->count_modes > 0) {
+			found = c->connector_id;
+		}
+		if (c) {
+			drmModeFreeConnector(c);
+		}
+	}
+	drmModeFreeResources(res);
+	return found;
+}
+
+RenderingContextDriver::SurfaceID RenderingContextDriverVulkanKMS::surface_create(const void *p_platform_data) {
+	const WindowPlatformData *wpd = (const WindowPlatformData *)(p_platform_data);
+	ERR_FAIL_COND_V_MSG(wpd->drm_fd < 0, SurfaceID(), "KMS: fd DRM invalide.");
+	ERR_FAIL_COND_V_MSG(display != VK_NULL_HANDLE, SurfaceID(), "KMS: un seul écran supporté pour l'instant.");
+
+	uint32_t connector = wpd->connector_id ? wpd->connector_id : _find_connected_connector(wpd->drm_fd);
+	ERR_FAIL_COND_V_MSG(connector == 0, SurfaceID(), "KMS: aucun connecteur connecté.");
+
+	// vkGetDrmDisplayEXT ne réussit que sur le GPU qui possède ce fd DRM.
+	VkPhysicalDevice pd = VK_NULL_HANDLE;
+	uint32_t pd_index = UINT32_MAX;
+	for (uint32_t i = 0; i < device_get_count(); i++) {
+		VkDisplayKHR d = VK_NULL_HANDLE;
+		if (vkGetDrmDisplayEXT(physical_device_get(i), wpd->drm_fd, connector, &d) == VK_SUCCESS && d != VK_NULL_HANDLE) {
+			pd = physical_device_get(i);
+			pd_index = i;
+			display = d;
+			break;
+		}
+	}
+	ERR_FAIL_COND_V_MSG(display == VK_NULL_HANDLE, SurfaceID(), "KMS: aucun GPU Vulkan ne gère ce fd DRM (VK_EXT_acquire_drm_display absent du driver ?).");
+
+	VkResult err = vkAcquireDrmDisplayEXT(pd, wpd->drm_fd, display);
+	if (err != VK_SUCCESS) {
+		display = VK_NULL_HANDLE;
+		ERR_FAIL_V_MSG(SurfaceID(), vformat("KMS: vkAcquireDrmDisplayEXT a échoué (%d). Le fd est-il DRM master ?", (int)err));
+	}
+
+	// Choix du mode : demandé, sinon plus grande surface puis plus haut refresh.
+	uint32_t mode_count = 0;
+	vkGetDisplayModePropertiesKHR(pd, display, &mode_count, nullptr);
+	TightLocalVector<VkDisplayModePropertiesKHR> modes;
+	modes.resize(mode_count);
+	vkGetDisplayModePropertiesKHR(pd, display, &mode_count, modes.ptr());
+	ERR_FAIL_COND_V_MSG(mode_count == 0, SurfaceID(), "KMS: l'écran n'expose aucun mode.");
+
+	int best = -1;
+	uint64_t best_score = 0;
+	for (int pass = 0; pass < 2 && best < 0; pass++) {
+		// Passe 0 : mode demandé ; passe 1 : repli sur le meilleur mode disponible.
+		bool constrained = pass == 0 && wpd->width && wpd->height;
+		for (uint32_t i = 0; i < mode_count; i++) {
+			const VkDisplayModeParametersKHR &p = modes[i].parameters;
+			uint64_t score = (uint64_t)p.visibleRegion.width * p.visibleRegion.height * 1000000ULL + p.refreshRate;
+			if (constrained) {
+				if (p.visibleRegion.width != wpd->width || p.visibleRegion.height != wpd->height) {
+					continue;
+				}
+				score = wpd->refresh_mhz ? (uint64_t)(1ULL << 62) - (uint64_t)abs((int)p.refreshRate - (int)wpd->refresh_mhz) : p.refreshRate;
+			}
+			if (best < 0 || score > best_score) {
+				best = (int)i;
+				best_score = score;
+			}
+		}
+		if (best < 0 && constrained) {
+			WARN_PRINT(vformat("KMS: mode %dx%d introuvable, repli sur le meilleur mode.", (int)wpd->width, (int)wpd->height));
+		}
+	}
+	ERR_FAIL_COND_V_MSG(best < 0, SurfaceID(), "KMS: aucun mode utilisable.");
+	VkDisplayModeKHR mode = modes[best].displayMode;
+	VkExtent2D extent = modes[best].parameters.visibleRegion;
+
+	// Plan compatible avec cet écran.
+	uint32_t plane_count = 0;
+	vkGetPhysicalDeviceDisplayPlanePropertiesKHR(pd, &plane_count, nullptr);
+	uint32_t plane_index = UINT32_MAX;
+	for (uint32_t i = 0; i < plane_count && plane_index == UINT32_MAX; i++) {
+		uint32_t n = 0;
+		vkGetDisplayPlaneSupportedDisplaysKHR(pd, i, &n, nullptr);
+		TightLocalVector<VkDisplayKHR> supported;
+		supported.resize(n);
+		vkGetDisplayPlaneSupportedDisplaysKHR(pd, i, &n, supported.ptr());
+		for (uint32_t j = 0; j < n; j++) {
+			if (supported[j] == display) {
+				plane_index = i;
+				break;
+			}
+		}
+	}
+	ERR_FAIL_COND_V_MSG(plane_index == UINT32_MAX, SurfaceID(), "KMS: aucun plan DRM compatible.");
+
+	VkDisplaySurfaceCreateInfoKHR info = {};
+	info.sType = VK_STRUCTURE_TYPE_DISPLAY_SURFACE_CREATE_INFO_KHR;
+	info.displayMode = mode;
+	info.planeIndex = plane_index;
+	info.planeStackIndex = 0;
+	info.transform = VK_SURFACE_TRANSFORM_IDENTITY_BIT_KHR;
+	info.globalAlpha = 1.0f;
+	info.alphaMode = VK_DISPLAY_PLANE_ALPHA_OPAQUE_BIT_KHR;
+	info.imageExtent = extent;
+
+	VkSurfaceKHR vk_surface = VK_NULL_HANDLE;
+	err = vkCreateDisplayPlaneSurfaceKHR(instance_get(), &info, get_allocation_callbacks(VK_OBJECT_TYPE_SURFACE_KHR), &vk_surface);
+	ERR_FAIL_COND_V_MSG(err != VK_SUCCESS, SurfaceID(), vformat("KMS: vkCreateDisplayPlaneSurfaceKHR a échoué (%d).", (int)err));
+
+	connector_id = connector;
+	display_device_index = pd_index;
+	display_size = Vector2i(extent.width, extent.height);
+	display_refresh_mhz = modes[best].parameters.refreshRate;
+
+	Surface *surface = memnew(Surface);
+	surface->vk_surface = vk_surface;
+	surface->width = extent.width;
+	surface->height = extent.height;
+	return SurfaceID(surface);
+}
+
+bool RenderingContextDriverVulkanKMS::device_supports_present(uint32_t p_device_index, SurfaceID p_surface) const {
+	// Sans ça, Godot choisit le GPU « discret » même si l'écran est sur l'iGPU,
+	// et la création de la swapchain échoue (VK_ERROR_INITIALIZATION_FAILED).
+	return p_device_index == display_device_index && RenderingContextDriverVulkan::device_supports_present(p_device_index, p_surface);
+}
+
+void RenderingContextDriverVulkanKMS::release_display() {
+	if (display != VK_NULL_HANDLE && display_device_index != UINT32_MAX) {
+		vkReleaseDisplayEXT(physical_device_get(display_device_index), display);
+		display = VK_NULL_HANDLE;
+	}
+}
+
+bool RenderingContextDriverVulkanKMS::reacquire_display(int p_drm_fd) {
+	ERR_FAIL_COND_V(display_device_index == UINT32_MAX || connector_id == 0, false);
+	VkPhysicalDevice pd = physical_device_get(display_device_index);
+	// Le handle peut avoir été invalidé par la libération : on le redemande.
+	VkDisplayKHR d = VK_NULL_HANDLE;
+	VkResult err = vkGetDrmDisplayEXT(pd, p_drm_fd, connector_id, &d);
+	ERR_FAIL_COND_V_MSG(err != VK_SUCCESS || d == VK_NULL_HANDLE, false, vformat("KMS: vkGetDrmDisplayEXT a échoué au retour de VT (%d).", (int)err));
+	err = vkAcquireDrmDisplayEXT(pd, p_drm_fd, d);
+	ERR_FAIL_COND_V_MSG(err != VK_SUCCESS, false, vformat("KMS: vkAcquireDrmDisplayEXT a échoué au retour de VT (%d).", (int)err));
+	display = d;
+	return true;
+}
+
+RenderingContextDriverVulkanKMS::RenderingContextDriverVulkanKMS() {
+}
+
+RenderingContextDriverVulkanKMS::~RenderingContextDriverVulkanKMS() {
+	release_display();
+}
+
+#endif // KMS_ENABLED
+#endif // VULKAN_ENABLED
diff --git a/platform/linuxbsd/kms/rendering_context_driver_vulkan_kms.h b/platform/linuxbsd/kms/rendering_context_driver_vulkan_kms.h
new file mode 100644
index 0000000..5d8b4b9
--- /dev/null
+++ b/platform/linuxbsd/kms/rendering_context_driver_vulkan_kms.h
@@ -0,0 +1,60 @@
+#pragma once
+
+#ifdef VULKAN_ENABLED
+#ifdef KMS_ENABLED
+
+#include "drivers/vulkan/rendering_context_driver_vulkan.h"
+#include "core/math/vector2i.h"
+
+// Surface Vulkan directe sur un écran DRM : VK_EXT_acquire_drm_display +
+// VK_KHR_display. Le fd DRM vient de libseat (KMSSeat) et reste propriété de
+// l'appelant.
+class RenderingContextDriverVulkanKMS : public RenderingContextDriverVulkan {
+private:
+	uint32_t display_device_index = UINT32_MAX;
+	VkDisplayKHR display = VK_NULL_HANDLE;
+	Vector2i display_size;
+	uint32_t display_refresh_mhz = 0;
+	uint32_t connector_id = 0;
+
+	virtual const char *_get_platform_surface_extension() const override final;
+	virtual void _register_platform_instance_extensions() override final;
+	virtual bool is_colorspace_externally_managed() const override final { return false; }
+
+protected:
+	SurfaceID surface_create(const void *p_platform_data) override final;
+
+public:
+	// Seul le GPU auquel l'écran DRM est branché peut y présenter.
+	virtual bool device_supports_present(uint32_t p_device_index, SurfaceID p_surface) const override;
+
+public:
+	struct WindowPlatformData {
+		int drm_fd = -1; // ouvert via libseat
+		uint32_t connector_id = 0; // 0 = premier connecteur connecté
+		uint32_t width = 0; // 0 = mode préféré / le plus grand
+		uint32_t height = 0;
+		uint32_t refresh_mhz = 0; // 0 = le plus haut
+	};
+
+	// Index (dans device_get) du GPU propriétaire du fd DRM ; valide après
+	// surface_create(). UINT32_MAX sinon.
+	uint32_t get_display_device_index() const { return display_device_index; }
+	// Taille réelle du mode choisi, pour le DisplayServer.
+	Vector2i get_display_size() const { return display_size; }
+	// Fréquence du mode choisi, en mHz (60000 = 60 Hz).
+	uint32_t get_display_refresh_mhz() const { return display_refresh_mhz; }
+
+	// Libère l'écran (vkReleaseDisplayEXT) — à appeler sur disable_seat.
+	void release_display();
+	// Reprend l'écran avec le nouveau fd DRM obtenu au retour de VT.
+	// La surface/swapchain existante est conservée (à redimensionner ensuite).
+	bool reacquire_display(int p_drm_fd);
+
+	RenderingContextDriverVulkanKMS();
+	~RenderingContextDriverVulkanKMS();
+
+};
+
+#endif // KMS_ENABLED
+#endif // VULKAN_ENABLED
