diff --git a/platform/linuxbsd/kms/SCsub b/platform/linuxbsd/kms/SCsub
new file mode 100644
index 0000000..1a056f2
--- /dev/null
+++ b/platform/linuxbsd/kms/SCsub
@@ -0,0 +1,16 @@
+#!/usr/bin/env python
+from misc.utility.scons_hints import *
+
+Import("env")
+
+File = env.File
+
+source_files = [File("kms_seat.cpp"), File("display_server_kms.cpp"), File("kms_input.cpp"), File("kms_watchdog.cpp")]
+
+# key_mapping_xkb.cpp est déjà compilé par wayland/SCsub quand Wayland est actif.
+if not env["wayland"]:
+    source_files.append(File("../wayland/key_mapping_xkb.cpp"))
+if env["vulkan"]:
+    source_files.append(File("rendering_context_driver_vulkan_kms.cpp"))
+
+Return("source_files")
diff --git a/platform/linuxbsd/kms/display_server_kms.cpp b/platform/linuxbsd/kms/display_server_kms.cpp
new file mode 100644
index 0000000..0491b5f
--- /dev/null
+++ b/platform/linuxbsd/kms/display_server_kms.cpp
@@ -0,0 +1,412 @@
+#ifdef KMS_ENABLED
+
+#include "display_server_kms.h"
+
+#include "core/config/project_settings.h"
+#include "core/input/input.h"
+#include "core/input/input_event.h"
+#include "core/os/os.h"
+#include "servers/display/native_menu.h"
+#include "servers/rendering/dummy/rasterizer_dummy.h"
+
+#if defined(RD_ENABLED)
+#include "servers/rendering/renderer_rd/renderer_compositor_rd.h"
+#include "servers/rendering/rendering_device.h"
+#if defined(VULKAN_ENABLED)
+#include "rendering_context_driver_vulkan_kms.h"
+#endif
+#endif
+
+#include <xf86drm.h>
+#include <xf86drmMode.h>
+#include <dirent.h>
+
+#include <algorithm>
+
+Vector<String> DisplayServerKMS::get_rendering_drivers_func() {
+	Vector<String> drivers;
+#ifdef VULKAN_ENABLED
+	drivers.push_back("vulkan");
+#endif
+	drivers.push_back("dummy");
+	return drivers;
+}
+
+DisplayServer *DisplayServerKMS::create_func(const String &p_rendering_driver, DisplayServerEnums::WindowMode p_mode, DisplayServerEnums::VSyncMode p_vsync_mode, uint32_t p_flags, const Vector2i *p_position, const Vector2i &p_resolution, int p_screen, DisplayServerEnums::Context p_context, int64_t p_parent_window, Error &r_error) {
+	DisplayServer *ds = memnew(DisplayServerKMS(p_rendering_driver, p_vsync_mode, r_error));
+	if (r_error != OK) {
+		if (p_rendering_driver == "vulkan") {
+			OS::get_singleton()->alert(
+					"The KMS display driver takes over the screen directly, so it must be started from a text console "
+					"(TTY, e.g. Ctrl+Alt+F3) and not from inside a graphical session (KDE, GNOME...).\n\n"
+					"If you are already on a TTY, check the log: the video driver may lack "
+					"VK_KHR_display / VK_EXT_acquire_drm_display.",
+					"Unable to initialize the KMS display driver");
+		}
+		memdelete(ds);
+		return nullptr;
+	}
+	return ds;
+}
+
+void DisplayServerKMS::register_kms_driver() {
+	register_create_function("kms", create_func, get_rendering_drivers_func);
+}
+
+void DisplayServerKMS::_dispatch_input_events(const Ref<InputEvent> &p_event) {
+	static_cast<DisplayServerKMS *>(get_singleton())->_dispatch_input_event(p_event);
+}
+
+void DisplayServerKMS::_dispatch_input_event(const Ref<InputEvent> &p_event) {
+	if (input_event_callback.is_valid()) {
+		input_event_callback.call(p_event);
+	}
+}
+
+void DisplayServerKMS::_send_window_event(DisplayServerEnums::WindowEvent p_event) {
+	if (window_event_callback.is_valid()) {
+		Variant event = int(p_event);
+		window_event_callback.call(event);
+	}
+}
+
+bool DisplayServerKMS::has_feature(DisplayServerEnums::Feature p_feature) const {
+	switch (p_feature) {
+		case DisplayServerEnums::FEATURE_MOUSE:
+		case DisplayServerEnums::FEATURE_CURSOR_SHAPE:
+		case DisplayServerEnums::FEATURE_HIDPI:
+			return true;
+		default:
+			return false;
+	}
+}
+
+Vector<DisplayServerEnums::WindowID> DisplayServerKMS::get_window_list() const {
+	Vector<DisplayServerEnums::WindowID> list;
+	list.push_back(DisplayServerEnums::MAIN_WINDOW_ID);
+	return list;
+}
+
+void DisplayServerKMS::window_set_vsync_mode(DisplayServerEnums::VSyncMode p_vsync_mode, DisplayServerEnums::WindowID p_window) {
+#if defined(RD_ENABLED)
+	if (rendering_context) {
+		rendering_context->window_set_vsync_mode(p_window, p_vsync_mode);
+	}
+#endif
+}
+
+DisplayServerEnums::VSyncMode DisplayServerKMS::window_get_vsync_mode(DisplayServerEnums::WindowID p_window) const {
+#if defined(RD_ENABLED)
+	if (rendering_context) {
+		return rendering_context->window_get_vsync_mode(p_window);
+	}
+#endif
+	return DisplayServerEnums::VSYNC_ENABLED;
+}
+
+void DisplayServerKMS::_apply_mouse_mode() {
+	DisplayServerEnums::MouseMode m = mouse_mode_override_enabled ? mouse_mode_override : mouse_mode;
+	input.set_pointer_mode(m == DisplayServerEnums::MOUSE_MODE_CAPTURED ? KMSInput::POINTER_CAPTURED : KMSInput::POINTER_VISIBLE);
+}
+
+void DisplayServerKMS::mouse_set_mode(DisplayServerEnums::MouseMode p_mode) {
+	mouse_mode = p_mode;
+	_apply_mouse_mode();
+}
+
+void DisplayServerKMS::mouse_set_mode_override(DisplayServerEnums::MouseMode p_mode) {
+	mouse_mode_override = p_mode;
+	_apply_mouse_mode();
+}
+
+void DisplayServerKMS::mouse_set_mode_override_enabled(bool p_override_enabled) {
+	mouse_mode_override_enabled = p_override_enabled;
+	_apply_mouse_mode();
+}
+
+void DisplayServerKMS::process_events() {
+	// Changements de VT : libseat appelle _seat_enable/_seat_disable.
+	if (seat.is_open()) {
+		seat.dispatch(0);
+	}
+	if (seat.is_active()) {
+		input.process();
+	}
+	watchdog.heartbeat();
+	Input::get_singleton()->flush_buffered_events();
+}
+
+// --- Session / VT -----------------------------------------------------------
+
+void DisplayServerKMS::_seat_disable(void *p_user) {
+	DisplayServerKMS *self = static_cast<DisplayServerKMS *>(p_user);
+	print_line("KMS: session désactivée (changement de VT)");
+	self->watchdog.on_session_disabled();
+	self->input.suspend();
+	// On perd le DRM master : plus aucun accès GPU/écran tant qu'on n'est pas
+	// de retour. window_can_draw() renvoie false (seat inactif) dès maintenant.
+#if defined(VULKAN_ENABLED) && defined(RD_ENABLED)
+	if (self->rendering_context) {
+		static_cast<RenderingContextDriverVulkanKMS *>(self->rendering_context)->release_display();
+	}
+#endif
+}
+
+void DisplayServerKMS::_seat_enable(void *p_user) {
+	DisplayServerKMS *self = static_cast<DisplayServerKMS *>(p_user);
+	if (!self->rendering_context && self->drm_path.is_empty()) {
+		return; // Premier enable (pendant seat.open()) ou driver dummy.
+	}
+	print_line("KMS: session réactivée");
+	self->watchdog.on_session_enabled();
+	self->input.resume();
+#if defined(VULKAN_ENABLED) && defined(RD_ENABLED)
+	if (self->rendering_context && self->drm_device_id >= 0) {
+		// libseat : les fds d'avant la désactivation sont à rouvrir.
+		self->seat.close_device(self->drm_device_id);
+		self->drm_device_id = self->seat.open_device(self->drm_path, self->drm_fd);
+		if (self->drm_device_id < 0) {
+			ERR_PRINT("KMS: impossible de rouvrir le GPU au retour de VT.");
+			return;
+		}
+		RenderingContextDriverVulkanKMS *ctx = static_cast<RenderingContextDriverVulkanKMS *>(self->rendering_context);
+		bool reacquired = ctx->reacquire_display(self->drm_fd);
+		print_line(vformat("KMS: ré-acquisition de l'écran : %s", reacquired ? "OK" : "ÉCHEC"));
+		if (reacquired) {
+			// Force la recréation de la swapchain au prochain present.
+			self->rendering_context->window_set_size(DisplayServerEnums::MAIN_WINDOW_ID, self->display_size.x, self->display_size.y);
+		}
+	}
+#endif
+}
+
+static String _connector_name(drmModeConnector *p_connector) {
+	return vformat("%s-%d", String::utf8(drmModeGetConnectorTypeName(p_connector->connector_type)), (int)p_connector->connector_type_id);
+}
+
+static bool _connector_is_internal(drmModeConnector *p_connector) {
+	return p_connector->connector_type == DRM_MODE_CONNECTOR_eDP ||
+			p_connector->connector_type == DRM_MODE_CONNECTOR_LVDS ||
+			p_connector->connector_type == DRM_MODE_CONNECTOR_DSI;
+}
+
+Error DisplayServerKMS::_open_drm() {
+	// Choix de la sortie, par ordre de priorité :
+	//  1. CYBERREALM_KMS_OUTPUT (ex. "DP-1", "eDP-2") ;
+	//  2. la dalle interne (eDP/LVDS/DSI), supposée être l'écran principal ;
+	//  3. le premier connecteur connecté, toutes cartes confondues.
+	String wanted = OS::get_singleton()->get_environment("CYBERREALM_KMS_OUTPUT");
+
+	Vector<String> cards;
+	DIR *dir = opendir("/dev/dri");
+	ERR_FAIL_NULL_V_MSG(dir, ERR_FILE_NOT_FOUND, "KMS: /dev/dri introuvable.");
+	while (dirent *e = readdir(dir)) {
+		String n = String::utf8(e->d_name);
+		if (n.begins_with("card")) {
+			cards.push_back("/dev/dri/" + n);
+		}
+	}
+	closedir(dir);
+	cards.sort();
+
+	constexpr int RANK_NONE = 99;
+	int best_rank = RANK_NONE;
+	String best_name;
+	String available;
+
+	for (const String &path : cards) {
+		int fd = -1;
+		int id = seat.open_device(path, fd);
+		if (id < 0) {
+			continue;
+		}
+		int card_rank = RANK_NONE;
+		uint32_t card_connector = 0;
+		String card_name;
+		if (drmModeRes *res = drmModeGetResources(fd)) {
+			for (int i = 0; i < res->count_connectors; i++) {
+				drmModeConnector *c = drmModeGetConnector(fd, res->connectors[i]);
+				if (!c) {
+					continue;
+				}
+				if (c->connection == DRM_MODE_CONNECTED && c->count_modes > 0) {
+					String name = _connector_name(c);
+					available += vformat(" %s(%s)", name, path.get_file());
+					int rank = (!wanted.is_empty() && wanted == name) ? 0 : (wanted.is_empty() && _connector_is_internal(c) ? 1 : 2);
+					if (!wanted.is_empty() && rank != 0) {
+						rank = RANK_NONE; // une sortie précise est demandée : les autres sont exclues.
+					}
+					if (rank < card_rank) {
+						card_rank = rank;
+						card_connector = c->connector_id;
+						card_name = name;
+					}
+				}
+				drmModeFreeConnector(c);
+			}
+			drmModeFreeResources(res);
+		}
+		if (card_connector && card_rank < best_rank) {
+			// Meilleure sortie jusqu'ici : on garde cette carte, on lâche la précédente.
+			if (drm_device_id >= 0) {
+				seat.close_device(drm_device_id);
+			}
+			drm_device_id = id;
+			drm_fd = fd;
+			drm_path = path;
+			drm_connector_id = card_connector;
+			best_rank = card_rank;
+			best_name = card_name;
+		} else {
+			seat.close_device(id);
+		}
+		if (best_rank == 0) {
+			break;
+		}
+	}
+	if (drm_device_id >= 0) {
+		print_line(vformat("KMS: sortie %s sur %s (connectées :%s)", best_name, drm_path, available));
+		return OK;
+	}
+	ERR_FAIL_V_MSG(ERR_CANT_OPEN, vformat("KMS: aucune sortie%s. Sorties connectées :%s", wanted.is_empty() ? String() : vformat(" '%s'", wanted), available.is_empty() ? String(" aucune") : available));
+}
+
+// Le greeter/compositeur précédent (plasmalogin, kwin...) laisse souvent son plan
+// curseur matériel actif : la swapchain Vulkan n'utilise que le plan principal,
+// donc l'ancien curseur resterait affiché en fantôme. On le désactive (le jeu
+// dessine son propre curseur, voir kms_cursor.gd). Nécessite d'être DRM master.
+static void _disable_hardware_cursors(int p_fd) {
+	drmModeRes *res = drmModeGetResources(p_fd);
+	if (!res) {
+		return;
+	}
+	for (int i = 0; i < res->count_crtcs; i++) {
+		drmModeSetCursor(p_fd, res->crtcs[i], 0, 0, 0);
+	}
+	drmModeFreeResources(res);
+}
+
+// --- Construction -----------------------------------------------------------
+
+DisplayServerKMS::DisplayServerKMS(const String &p_rendering_driver, DisplayServerEnums::VSyncMode p_vsync_mode, Error &r_error) {
+	rendering_driver = p_rendering_driver;
+	r_error = ERR_UNAVAILABLE;
+
+	native_menu = memnew(NativeMenu);
+	Input::get_singleton()->set_event_dispatch_function(_dispatch_input_events);
+
+	seat.on_enable = _seat_enable;
+	seat.on_disable = _seat_disable;
+	seat.callback_user = this;
+	if (seat.open() != OK) {
+		return;
+	}
+
+	if (rendering_driver == "dummy") {
+		RasterizerDummy::make_current();
+		r_error = OK;
+		return;
+	}
+
+#if defined(RD_ENABLED) && defined(VULKAN_ENABLED)
+	if (rendering_driver != "vulkan") {
+		r_error = ERR_UNAVAILABLE;
+		return;
+	}
+	if (_open_drm() != OK) {
+		return;
+	}
+	_disable_hardware_cursors(drm_fd);
+
+	rendering_context = memnew(RenderingContextDriverVulkanKMS);
+	if (rendering_context->initialize() != OK) {
+		memdelete(rendering_context);
+		rendering_context = nullptr;
+		r_error = ERR_CANT_CREATE;
+		return;
+	}
+
+	RenderingContextDriverVulkanKMS::WindowPlatformData wpd;
+	wpd.drm_fd = drm_fd;
+	wpd.connector_id = drm_connector_id;
+	// Mode forcé : CYBERREALM_KMS_MODE="1920x1080" ou "1920x1080@60". Sans cela, le plus grand
+	// mode de l'écran est pris (les fenêtres clientes ne sont pas rééchelonnées : sur un écran
+	// plus dense que d'habitude le texte des fenêtres paraît plus flou).
+	String mode_env = OS::get_singleton()->get_environment("CYBERREALM_KMS_MODE");
+	if (!mode_env.is_empty()) {
+		Vector<String> hz_split = mode_env.split("@");
+		Vector<String> wh = hz_split[0].split("x");
+		if (wh.size() == 2 && wh[0].is_valid_int() && wh[1].is_valid_int()) {
+			wpd.width = wh[0].to_int();
+			wpd.height = wh[1].to_int();
+			if (hz_split.size() > 1 && hz_split[1].is_valid_float()) {
+				wpd.refresh_mhz = uint32_t(hz_split[1].to_float() * 1000.0);
+			}
+		} else {
+			WARN_PRINT(vformat("KMS: CYBERREALM_KMS_MODE='%s' invalide (attendu WxH ou WxH@Hz).", mode_env));
+		}
+	}
+	if (rendering_context->window_create(DisplayServerEnums::MAIN_WINDOW_ID, &wpd) != OK) {
+		memdelete(rendering_context);
+		rendering_context = nullptr;
+		r_error = ERR_CANT_CREATE;
+		return;
+	}
+	RenderingContextDriverVulkanKMS *kms_context = static_cast<RenderingContextDriverVulkanKMS *>(rendering_context);
+	display_size = kms_context->get_display_size();
+	if (kms_context->get_display_refresh_mhz() > 0) {
+		refresh_rate = kms_context->get_display_refresh_mhz() / 1000.0f;
+	}
+	rendering_context->window_set_size(DisplayServerEnums::MAIN_WINDOW_ID, display_size.x, display_size.y);
+	rendering_context->window_set_vsync_mode(DisplayServerEnums::MAIN_WINDOW_ID, p_vsync_mode);
+
+	rendering_device = memnew(RenderingDevice);
+	if (rendering_device->initialize(rendering_context, DisplayServerEnums::MAIN_WINDOW_ID) != OK) {
+		memdelete(rendering_device);
+		rendering_device = nullptr;
+		memdelete(rendering_context);
+		rendering_context = nullptr;
+		r_error = ERR_UNAVAILABLE;
+		return;
+	}
+	rendering_device->screen_create(DisplayServerEnums::MAIN_WINDOW_ID);
+	RendererCompositorRD::make_current();
+
+	if (input.initialize(&seat, display_size) != OK) {
+		WARN_PRINT("KMS: entrées indisponibles (libinput/xkbcommon) — le jeu ne recevra ni clavier ni souris.");
+	}
+
+	print_line(vformat("KMS: %dx%d@%.2f Hz", display_size.x, display_size.y, refresh_rate));
+	watchdog.start();
+	r_error = OK;
+#else
+	r_error = ERR_UNAVAILABLE;
+#endif
+}
+
+DisplayServerKMS::~DisplayServerKMS() {
+	watchdog.stop();
+	if (native_menu) {
+		memdelete(native_menu);
+		native_menu = nullptr;
+	}
+#if defined(RD_ENABLED)
+	if (rendering_device) {
+		rendering_device->screen_free(DisplayServerEnums::MAIN_WINDOW_ID);
+		memdelete(rendering_device);
+		rendering_device = nullptr;
+	}
+	if (rendering_context) {
+		rendering_context->window_destroy(DisplayServerEnums::MAIN_WINDOW_ID);
+		memdelete(rendering_context);
+		rendering_context = nullptr;
+	}
+#endif
+	input.finalize();
+	if (drm_device_id >= 0) {
+		seat.close_device(drm_device_id);
+	}
+	seat.close();
+}
+
+#endif // KMS_ENABLED
