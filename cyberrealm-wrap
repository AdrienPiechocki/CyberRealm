#!/usr/bin/env bash
set -e

# CyberRealm Wayland Session
# Lance le compositeur/bureau CyberRealm.
# Utilisation :
#   ./cyberrealm-session          # depuis un TTY ou session DM
#   ./cyberrealm-session --xorg   # force Xorg (nécessite xinit)
#   ./cyberrealm-session --wayland # utilise le Wayland existant

DIR="$(cd "$(dirname "$0")" && pwd)"

# --- Détection du binaire du jeu --------------------------------------------
GAME_BIN=""
GAME_ARGS=()

find_game() {
    for d in "$DIR/../CyberRealm" "$HOME/CyberRealm" "/opt/cyberrealm" "/usr/lib/cyberrealm"; do
        if [ -x "$d/CyberRealm.x86_64" ]; then
            GAME_BIN="$d/CyberRealm.x86_64"
            return 0
        fi
    done

    local PROJ_DIR=""
    for pd in "$DIR/../demo" "$DIR/demo" "$HOME/Projets/wayland-godot/demo"; do
        if [ -f "$pd/project.godot" ]; then
            PROJ_DIR="$pd"
            break
        fi
    done

    if [ -n "$PROJ_DIR" ]; then
        for g in godot godot4; do
            if command -v "$g" &>/dev/null; then
                GAME_BIN="$g"
                GAME_ARGS=(--path "$PROJ_DIR" --fullscreen)
                return 0
            fi
        done
    fi

    return 1
}

find_game || {
    echo "CyberRealm: aucun binaire ni moteur Godot trouvé." >&2
    echo "Lance d'abord ./build-install.sh ou installe Godot." >&2
    exit 1
}

# --- Environnement -----------------------------------------------------------
export XDG_CURRENT_DESKTOP=CyberRealm
export GTK_USE_PORTAL=0
export GIO_USE_PORTALS=0

# --- Lancement --------------------------------------------------------------
MODE="${1:-auto}"

case "$MODE" in
    --xorg)
        export XDG_SESSION_TYPE=x11
        export GDK_BACKEND=x11
        export QT_QPA_PLATFORM=x11

        set -- xinit "$GAME_BIN"
        [ ${#GAME_ARGS[@]} -gt 0 ] && set -- "$@" "${GAME_ARGS[@]}"
        set -- "$@" -- :0 vt"${XDG_VTNR:-1}" -nolisten tcp -keeptty
        exec "$@"
        ;;

    --wayland)
        export XDG_SESSION_TYPE=wayland
        export GDK_BACKEND=wayland
        export QT_QPA_PLATFORM=wayland
        export MOZ_ENABLE_WAYLAND=1
        export _JAVA_AWT_WM_NONREPARENTING=1
        exec "$GAME_BIN" "${GAME_ARGS[@]}"
        ;;

    auto|*)
        if [ -n "${WAYLAND_DISPLAY:-}" ]; then
            export XDG_SESSION_TYPE=wayland
            export GDK_BACKEND=wayland
            export QT_QPA_PLATFORM=wayland
            export MOZ_ENABLE_WAYLAND=1
            export _JAVA_AWT_WM_NONREPARENTING=1
            exec "$GAME_BIN" "${GAME_ARGS[@]}"
        elif [ -n "${DISPLAY:-}" ]; then
            exec "$GAME_BIN" "${GAME_ARGS[@]}"
        else
            export XDG_SESSION_TYPE=x11
            export GDK_BACKEND=x11
            export QT_QPA_PLATFORM=x11

            set -- xinit "$GAME_BIN"
            [ ${#GAME_ARGS[@]} -gt 0 ] && set -- "$@" "${GAME_ARGS[@]}"
            set -- "$@" -- :0 vt"${XDG_VTNR:-1}" -nolisten tcp -keeptty
            exec "$@"
        fi
        ;;
esac
